# source. Buy them on Fab and drop them into /Content (see README).
Content/Statium_Soccer/
Content/White_Football_Player/

# ─── World-Partition actor data for Epic template/demo levels (not shipped) ───
Content/__ExternalActors__/
Content/__ExternalObjects__/

# ─── Stadium-screen branding (Fab-stadium-specific; not used by Lvl_Match) ───
# Textures embed a machine reimport path; the material instances + widget are
# orphaned once the Fab stadium (+ its M_ToroStudio parent) is excluded.
# All of this still ships inside the packaged game.
Content/Ascertainty/UI/T_ScreenDashboard.uasset
Content/Ascertainty/UI/T_ScreenGraphic.uasset
Content/Ascertainty/Screens/T_OH_1.uasset
Content/Ascertainty/Screens/T_OH_2.uasset
Content/Ascertainty/Screens/T_OH_3.uasset
Content/Ascertainty/Screens/T_Side_Display.uasset
